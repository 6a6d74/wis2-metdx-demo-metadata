    "properties": {
        "type": "dataset",
        "identifier": "urn:wmo:md:io-wis2dev-metdx-demo:era5.single-levels.arco.edr",
        "title": "ERA5 hourly reanalysis on single levels, served from cloud-optimised Zarr",
        "description": "Hourly ERA5 global atmospheric reanalysis from ECMWF on single levels, produced for the Copernicus Climate Change Service. Covers 1940 to about five days ago at 0.25 degree resolution, with 20 variables including 2 m temperature and dew point, mean sea level and surface pressure, 10 m and 100 m wind, wind gusts, total precipitation, total cloud cover, cloud base height, boundary layer height, skin and sea surface temperature, and surface radiation and heat fluxes. The data are read from the Copernicus analysis-ready, cloud-optimised (ARCO) Zarr stores and served through the OGC Environmental Data Retrieval (EDR) API on Destination Earth infrastructure, supporting position, area and cube queries that return CoverageJSON.",
        "language": "en",
